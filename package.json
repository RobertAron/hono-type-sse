{
  "name": "@robertaron/hono-typed-sse",
  "version": "0.2.1",
  "files": [
    "dist/"
  ],
  "private": false,
  "exports": {
    "./connectToSse": {
      "types": "./dist/connectToSse.d.ts",
      "import": "./dist/connectToSse.js",
      "require": "./dist/connectToSse.cjs"
    },
    "./typedSSE": {
      "types": "./dist/typedSSE.d.ts",
      "import": "./dist/typedSSE.js",
      "require": "./dist/typedSSE.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "connectToSse": [
        "./dist/connectToSse.d.ts"
      ],
      "typedSSE": [
        "./dist/typedSSE.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertAron/hono-type-sse"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@hono/node-server": "^1.17.1",
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.12.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "example:server": "bun --watch ./example/server.ts",
    "build": "rm -rf dist && tsup --config tsup.ts",
    "publish": "npm run build && npm publish"
  }
}
